# elder-care-app 後端 API 位址
VITE_API_BASE=http://localhost:5000

# STT WebSocket 服務位址（語音辨識）
VITE_STT_WS_URL=ws://localhost:8001/ws/transcribe

# Cognito 設定（跟後端 .env 的值一樣）
VITE_COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=your_app_client_id
VITE_COGNITO_REDIRECT_URI=http://localhost:5000/api/auth/callback
