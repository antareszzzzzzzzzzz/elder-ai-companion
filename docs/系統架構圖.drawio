          <mxGeometry x="520" y="120" width="300" height="470" as="geometry" />
        </mxCell>
        <mxCell id="flask" value="Flask REST API　:5000&#10;&#10;Blueprints&#10;auth / chat / profile / follow&#10;summary / health-overview / care-items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#2E7D4F;fontSize=11;fontStyle=0;fontColor=#1B5E35;verticalAlign=top;spacingTop=8;" vertex="1" parent="appserver">
          <mxGeometry x="20" y="40" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="scheduler" value="背景排程執行緒（daemon）&#10;每 60 秒檢查每日摘要排程&#10;條件：已過設定時間且當天尚無摘要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#C4620E;fontSize=11;fontColor=#8A4508;" vertex="1" parent="appserver">
          <mxGeometry x="20" y="160" width="260" height="70" as="geometry" />
