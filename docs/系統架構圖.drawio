        <mxCell id="dynamodb" value="Amazon DynamoDB&#10;PAY_PER_REQUEST" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="awscloud">
          <mxGeometry x="410" y="230" width="70" height="70" as="geometry" />
        </mxCell>

        <mxCell id="tables" value="DynamoDB 資料表（8 張）&#10;&#10;Accounts　　　　帳號與健康基本資料&#10;Follows　　　　　追蹤關係＋推播時間設定&#10;Facts　　　　　　記憶卡（生活事實）&#10;FactHistory　　　記憶卡變更歷程&#10;Sessions　　　　對話工作階段&#10;Messages　　　　對話訊息&#10;DailySummaries　每日／每週摘要&#10;HealthKnowledgeBase　衛教知識庫" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F4FF;strokeColor=#3334B9;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontColor=#22247F;" vertex="1" parent="awscloud">
          <mxGeometry x="50" y="360" width="430" height="180" as="geometry" />
        </mxCell>

        <mxCell id="future" value="未來規劃（目前未採用）&#10;以 EventBridge Scheduler + Lambda 取代應用伺服器內的背景執行緒，&#10;使摘要產生不依賴伺服器運行狀態。詳見「技術限制與未來規劃」。" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#FAFAFA;strokeColor=#9AA9B8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontColor=#5A6C7D;container=1;collapsible=0;" vertex="1" parent="awscloud">
          <mxGeometry x="50" y="570" width="430" height="110" as="geometry" />
        </mxCell>
        <mxCell id="eventbridge" value="EventBridge&#10;Scheduler" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F34482;gradientDirection=north;fillColor=#BC1356;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;opacity=60;" vertex="1" parent="future">
          <mxGeometry x="250" y="45" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lambda" value="Lambda" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;opacity=60;" vertex="1" parent="future">
          <mxGeometry x="350" y="45" width="50" height="50" as="geometry" />
        </mxCell>

        <!-- ===================== 照護者信箱 ===================== -->
        <mxCell id="mailbox" value="照護者信箱" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF6D6;strokeColor=#D6B656;size=14;fontSize=11;fontColor=#7F6000;" vertex="1" parent="1">
          <mxGeometry x="230" y="700" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- ===================== 連線 ===================== -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#41505F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="userElder" target="spa">
          <mxGeometry relative="1" as="geometry" />
