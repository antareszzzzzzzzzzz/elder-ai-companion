        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#41505F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="userCarer" target="spa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="① OAuth 授權碼流程&#10;Hosted UI 登入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C7131F;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#C7131F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="spa" target="cognito">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="② REST /api&#10;Bearer id_token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E7D4F;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=10;fontColor=#1B5E35;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="spa" target="flask">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="③ WebSocket&#10;binary PCM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5E35B1;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=10;fontColor=#3F2680;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mic" target="sttsvc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e6" value="④ 串流語音辨識" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#116D5B;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=10;fontColor=#116D5B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sttsvc" target="transcribe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e7" value="⑤ token 交換 / JWKS 驗簽" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C7131F;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;fontSize=10;fontColor=#C7131F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="flask" target="cognito">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e8" value="⑥ 兩次獨立呼叫&#10;Call#1 生成回覆&#10;Call#2 產出記憶操作 JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#116D5B;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#116D5B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="flask" target="bedrock">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e9" value="⑦ 文字轉語音" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#116D5B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#116D5B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="flask" target="polly">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e10" value="⑧ 讀寫（scan / query / 交易寫入）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3334B9;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=10;fontColor=#22247F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="flask" target="dynamodb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e11" value="⑨ 到點產生摘要" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C4620E;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;fontSize=10;fontColor=#8A4508;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scheduler" target="bedrock">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e12" value="⑩ 寄送通知信&#10;收件地址由 Cognito 反查" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BC1356;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#BC1356;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scheduler" target="ses">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e13" value="⑪ 摘要信" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BC1356;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#BC1356;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="ses" target="mailbox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="mailbox" target="userCarer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== 圖例 ===================== -->
        <mxCell id="legend" value="說明&#10;&#10;• 實線＝主要請求路徑；虛線＝背景或降級路徑&#10;• LLM 呼叫統一經過 invoke_bedrock()，維持兩次獨立呼叫的分工&#10;• 記憶操作由 LLM 產出 JSON 指令，實際寫入一律由 Python 執行&#10;• 使用者身分一律取自 JWT 的 sub，不採用請求內容帶入的 account_id&#10;• 音訊以 base64 內嵌 JSON 回傳，不使用物件儲存或串流端點" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA9B8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontColor=#41505F;" vertex="1" parent="1">
          <mxGeometry x="520" y="620" width="360" height="150" as="geometry" />
        </mxCell>

      </root>
